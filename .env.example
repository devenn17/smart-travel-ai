# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas (Recommended):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_travel_planner?retryWrites=true&w=majority
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_travel_planner

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_hash

# Client Vite Configuration
VITE_API_URL=http://localhost:5000

# Google Gemini AI Integration (Required for Dynamic Itinerary Generation)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
